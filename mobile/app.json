{
  "expo": {
    "name": "CoinProwl",
    "slug": "coinprowl",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0e1a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.coinprowl.app",
      "buildNumber": "27",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "CoinProwl needs your location to show you on the game map and let you interact with nearby players and coin drops.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "CoinProwl uses your location to track your position on the game map even when the app is in the background.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0e1a"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.coinprowl.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CoinProwl needs your location to show you on the game map."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "11126288-80da-4f3a-ace6-3a26ed62bd4b"
      }
    },
    "owner": "arialtravel"
  }
}
