PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/geopvp
JWT_SECRET=your-jwt-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# App
APP_NAME=GeoPVP
FRONTEND_URL=http://localhost:8081
ATTACK_RADIUS_MILES=0.25
SHIELD_PRICE_CENTS=99
SHIELD_DURATION_MINUTES=10
MAX_SHIELDS_PER_BUYIN=3
