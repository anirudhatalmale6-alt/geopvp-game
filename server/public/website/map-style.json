{
  "version": 8,
  "name": "CoinProwl Dark",
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "omt": { "type": "vector", "url": "https://tiles.openfreemap.org/planet" }
  },
  "layers": [
    { "id": "bg", "type": "background", "paint": { "background-color": "#0b0f17" } },

    { "id": "landcover-wood", "type": "fill", "source": "omt", "source-layer": "landcover",
      "filter": ["==", "class", "wood"],
      "paint": { "fill-color": "#0e141d", "fill-opacity": 0.9 } },
    { "id": "landcover-grass", "type": "fill", "source": "omt", "source-layer": "landcover",
      "filter": ["in", "class", "grass", "farmland"],
      "paint": { "fill-color": "#0d121b", "fill-opacity": 0.85 } },
    { "id": "park", "type": "fill", "source": "omt", "source-layer": "park",
      "paint": { "fill-color": "#0e151e", "fill-opacity": 0.8 } },
    { "id": "landuse-urban", "type": "fill", "source": "omt", "source-layer": "landuse",
      "filter": ["in", "class", "residential", "commercial", "industrial", "retail"],
      "paint": { "fill-color": "#111722", "fill-opacity": 0.7 } },

    { "id": "water", "type": "fill", "source": "omt", "source-layer": "water",
      "filter": ["!=", "brunnel", "tunnel"],
      "paint": { "fill-color": "#232c3c" } },
    { "id": "waterway", "type": "line", "source": "omt", "source-layer": "waterway",
      "paint": { "line-color": "#232c3c", "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.5, 16, 2.5] } },

    { "id": "building", "type": "fill", "source": "omt", "source-layer": "building",
      "minzoom": 14,
      "paint": { "fill-color": "#161d2a", "fill-opacity": ["interpolate", ["linear"], ["zoom"], 14, 0, 16, 0.85] } },

    { "id": "road-minor", "type": "line", "source": "omt", "source-layer": "transportation",
      "minzoom": 11,
      "filter": ["in", "class", "minor", "service", "track", "path"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#1a2231",
        "line-width": ["interpolate", ["linear"], ["zoom"], 11, 0.4, 16, 3, 20, 12] } },
    { "id": "road-secondary", "type": "line", "source": "omt", "source-layer": "transportation",
      "minzoom": 8,
      "filter": ["in", "class", "secondary", "tertiary"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#20293a",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.5, 14, 3, 20, 16] } },
    { "id": "road-primary", "type": "line", "source": "omt", "source-layer": "transportation",
      "minzoom": 6,
      "filter": ["in", "class", "primary", "trunk"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#263144",
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.5, 14, 4, 20, 20] } },
    { "id": "road-motorway", "type": "line", "source": "omt", "source-layer": "transportation",
      "minzoom": 6,
      "filter": ["==", "class", "motorway"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#2d3a51",
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.4, 10, 1.8, 14, 5, 20, 24],
        "line-opacity": ["interpolate", ["linear"], ["zoom"], 6, 0.45, 9, 1] } },

    { "id": "boundary-state", "type": "line", "source": "omt", "source-layer": "boundary",
      "filter": ["==", "admin_level", 4],
      "paint": { "line-color": "#2b3446", "line-width": 0.7, "line-dasharray": [3, 2], "line-opacity": 0.55 } },
    { "id": "boundary-country", "type": "line", "source": "omt", "source-layer": "boundary",
      "filter": ["<=", "admin_level", 2],
      "paint": { "line-color": "#3a4560", "line-width": 1, "line-opacity": 0.75 } },

    { "id": "water-label", "type": "symbol", "source": "omt", "source-layer": "water_name",
      "layout": { "text-field": ["get", "name"], "text-font": ["Noto Sans Italic"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 4, 10, 12, 14] },
      "paint": { "text-color": "#46536b", "text-halo-color": "#0b0f17", "text-halo-width": 1 } },

    { "id": "place-town", "type": "symbol", "source": "omt", "source-layer": "place",
      "filter": ["in", "class", "town", "village", "suburb"],
      "minzoom": 9,
      "layout": { "text-field": ["get", "name"], "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 9, 10, 14, 13] },
      "paint": { "text-color": "#6d7c96", "text-halo-color": "#0b0f17", "text-halo-width": 1.4 } },
    { "id": "place-city", "type": "symbol", "source": "omt", "source-layer": "place",
      "filter": ["==", "class", "city"],
      "layout": { "text-field": ["get", "name"], "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 4, 11, 10, 15] },
      "paint": { "text-color": "#8b9ab4", "text-halo-color": "#0b0f17", "text-halo-width": 1.6 } },
    { "id": "place-state", "type": "symbol", "source": "omt", "source-layer": "place",
      "filter": ["==", "class", "state"], "maxzoom": 7,
      "layout": { "text-field": ["get", "name"], "text-font": ["Noto Sans Bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 3, 9, 6, 12],
        "text-transform": "uppercase", "text-letter-spacing": 0.14 },
      "paint": { "text-color": "#5b6880", "text-halo-color": "#0b0f17", "text-halo-width": 1.4 } },
    { "id": "place-country", "type": "symbol", "source": "omt", "source-layer": "place",
      "filter": ["==", "class", "country"], "maxzoom": 8,
      "layout": { "text-field": ["get", "name"], "text-font": ["Noto Sans Bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 2, 10, 6, 14],
        "text-transform": "uppercase", "text-letter-spacing": 0.16 },
      "paint": { "text-color": "#7e8da7", "text-halo-color": "#0b0f17", "text-halo-width": 1.6 } }
  ]
}
